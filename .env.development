# 개발(dev) 환경 — 로컬 백엔드(dev DB: unisize)를 바라봅니다.
# 백엔드를 `make run-dev`로 띄운 상태에서 사용하세요.
VITE_API_BASE_URL=http://localhost:8080

# QA 편의를 위해 신체 사이즈 입력을 선택 사항으로 완화합니다 (register/MeasurementInputPage).
VITE_OPTIONAL_MEASUREMENT=true

# 화면에 표시되는 브랜드명. 미설정 시 운영 문구("스마트학생복 청주점")로 폴백합니다.
VITE_BRAND_NAME=유니사이즈

# 데모 편의를 위해 관리자/스태프 로그인 폼에 미리 채워둘 dev 전용 계정입니다.
# 운영에서는 정의하지 않으므로 빈 값으로 폴백됩니다 (src/constants/devAccount.ts).
VITE_DEV_ADMIN_ID=01012345678
VITE_DEV_ADMIN_PASSWORD=devadmin1234
VITE_DEV_STAFF_ID=01087654321
VITE_DEV_STAFF_PASSWORD=devstaff1234
